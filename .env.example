
# ==========================================
# TAXIFY V2 - LARAVEL 12 BACKEND
# ==========================================

APP_NAME="Taxify V2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# ==========================================
# LOCALIZATION
# ==========================================

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ==========================================
# APPLICATION
# ==========================================

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ==========================================
# LOGGING
# ==========================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# POSTGRESQL DATABASE
# ==========================================

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taxify
DB_USERNAME=taxify_app
DB_PASSWORD=

# ==========================================
# SESSION
# ==========================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# CACHE & QUEUE
# ==========================================

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==========================================
# BROADCAST & FILE STORAGE
# ==========================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ==========================================
# REDIS (OPTIONAL - NOT ACTIVE)
# ==========================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# EMAIL - DEVELOPMENT
# ==========================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@taxify.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS (NOT CONFIGURED)
# ==========================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# FRONTEND
# ==========================================

VITE_APP_NAME="${APP_NAME}"
